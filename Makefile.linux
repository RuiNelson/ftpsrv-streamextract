ELF := ftpsrv-posix.elf

VERSION_TAG := $(shell git describe --abbrev=6 --dirty --always --tags)

CFLAGS := -Wall -Werror -DVERSION_TAG=\"$(VERSION_TAG)\" -I. -pthread
CFLAGS += -O2
# Extra defines for build variants, e.g. EXTRA_CFLAGS=-DFTP_MC_RING_SIZE=4194304
CFLAGS += $(EXTRA_CFLAGS)
SOURCE := srv.c cmd.c mc.c notify.c io.c self.c sha256.c
SOURCE += main-linux.c cmd-linux.c self-linux.c
SOURCE += io-linux.c
HEADERS := $(wildcard *.h)

.PHONY: all clean test check

all: $(ELF)

$(ELF): $(SOURCE) $(HEADERS) Makefile.linux
	$(CC) $(CFLAGS) -o $@ $(SOURCE)

.build/test-control: test/test-control.c $(filter-out main-linux.c,$(SOURCE)) $(HEADERS) Makefile.linux
	@mkdir -p .build
	$(CC) $(CFLAGS) -o $@ test/test-control.c $(filter-out main-linux.c,$(SOURCE))

.build/test-sockets: test/test-sockets.c $(filter-out main-linux.c,$(SOURCE)) $(HEADERS) Makefile.linux
	@mkdir -p .build
	$(CC) $(CFLAGS) -o $@ test/test-sockets.c $(filter-out main-linux.c,$(SOURCE)) \
		-Wl,--wrap=socket,--wrap=accept,--wrap=connect,--wrap=listen \
		-Wl,--wrap=setsockopt,--wrap=getsockopt,--wrap=close

check: $(ELF) .build/test-control .build/test-sockets
	./.build/test-control
	./.build/test-sockets
	python3 test/test-transfers.py ./$(ELF)

clean:
	rm -f $(ELF)

test: $(ELF)
	./$^
